# BD QuickMart - Admin Web environment configuration
# Copy to `.env` and adjust for your machine. NEVER commit `.env`.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never place secrets in this file.

# Backend base URL including the /api/v1 prefix.
# For a browser on the same machine, localhost works. If you open the admin
# site from another device on your LAN, use the host's LAN IP instead, e.g.
#   VITE_API_BASE_URL=http://192.168.1.20:8080/api/v1
# MUST match the origin listed in APP_CORS_ALLOWED_ORIGINS on the backend.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# WebSocket endpoint for operational dashboards.
VITE_WS_BASE_URL=ws://localhost:8080/ws/tracking

# Request timeout in milliseconds.
VITE_REQUEST_TIMEOUT=30000

# Set to false for production builds.
VITE_IS_DEVELOPMENT=true

# ---------------------------------------------------------------------
# PRODUCTION (Vercel) - set these in the Vercel project settings BEFORE
# the build. VITE_* values are baked into the JS bundle at build time;
# changing them requires a redeploy. They are PUBLIC (visible in the
# browser bundle), so NEVER put a secret here.
#
# The ACTIVE production values live in vercel.json (top-level "env"), so a
# Vercel deploy builds with production config out of the box. They are
# PUBLIC URLs/flags, NEVER secrets. Verified live on 2026-11-14: the Render
# service returned the BD QuickMart API (liveness 200, /api/v1/health 200,
# WSS 101). Copy the block below into Vercel > Project > Settings >
# Environment Variables (Production) to override without a commit.
# (Kept commented so copying this file to .env keeps the LOCAL dev defaults
#  above intact - Vite must not see two active VITE_API_BASE_URL keys.)
# ---------------------------------------------------------------------
# VITE_API_BASE_URL=https://bd-quickmart-backend.onrender.com/api/v1
# VITE_WS_BASE_URL=wss://bd-quickmart-backend.onrender.com/ws/tracking
# VITE_REQUEST_TIMEOUT=30000
# VITE_IS_DEVELOPMENT=false
#
# The production API origin (https://<VERCEL_HOST>) must ALSO be added to
# the backend's APP_CORS_ALLOWED_ORIGINS on Render. WebConfig uses
# setAllowCredentials(true) with an explicit list, so "*" is not valid.
# VERIFIED 2026-11-14: the deployed backend currently allows only
# http://localhost:5173 and http://localhost:3000 - every vercel.app origin
# returned 403 on preflight. Set APP_CORS_ALLOWED_ORIGINS in the Render
# dashboard to include the real Vercel origin (see DEPLOYMENT.md).
#
# SPA deep links (/orders, /riders, ...) are handled by vercel.json's
# rewrite to /index.html. The project's "Root Directory" must be set to
# `admin-web` in the Vercel dashboard (it is NOT a vercel.json field).
