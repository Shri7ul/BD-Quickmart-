# BD QuickMart - Customer App environment configuration
# Copy to `.env` and adjust for your machine. NEVER commit `.env`.

# Backend base URL including the /api/v1 prefix.
# Android emulator reaches the host machine at 10.0.2.2.
# iOS simulator can use http://localhost:8080/api/v1
# Physical device: use your machine's LAN IP, e.g. http://192.168.0.10:8080/api/v1
API_BASE_URL=http://10.0.2.2:8080/api/v1

# WebSocket endpoint for live order tracking.
WS_BASE_URL=ws://10.0.2.2:8080/ws/tracking

# Set to false for production builds.
IS_DEVELOPMENT=true
