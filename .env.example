# =====================================================================
# BD QuickMart - Root environment template
# =====================================================================
# Copy this file to `.env` in the repository root and adjust the values
# for your machine.  NEVER commit the `.env` file.
#
# The backend reads configuration from environment variables. If you run
# the backend from an IDE, set these in the run configuration, or export
# them in your shell before starting the app.
#
# The two Flutter applications and the admin web app each have their own
# `.env.example` next to their source, because Vite/Flutter bundle
# configuration differently from the Spring backend.
# =====================================================================


# ---------------------------------------------------------------------
# Database (MySQL 8 via XAMPP)
# ---------------------------------------------------------------------
# Create the database first through phpMyAdmin - see
# docs/development/local-setup.md
DB_URL=jdbc:mysql://localhost:3306/bd_quickmart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Dhaka&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# Hibernate schema handling.
# `none` keeps MySQL in charge of the schema. Do not use `update` in
# production: schema migrations are introduced in a later goal.
DB_DDL_AUTO=none

# Pinned so the Spring context can start even when MySQL is stopped.
DB_DIALECT=org.hibernate.dialect.MySQLDialect
# Minimum server version the dialect targets. Keeps Hibernate from falling
# back to its MySQL 5.5.5 compatibility mode.
DB_DIALECT_VERSION=8.0.0


# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL_BACKEND=INFO
LOG_LEVEL_SQL=INFO


# ---------------------------------------------------------------------
# API
# ---------------------------------------------------------------------
APP_API_VERSION=v1
APP_API_BASE_PATH=/api

# Comma-separated list of origins allowed to call the API from a browser.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ---------------------------------------------------------------------
# AI providers (Gemini / Groq)
# ---------------------------------------------------------------------
# Supply real keys locally; leave blank to run with AI features disabled.
# Never commit real keys to the repository.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_CHAT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=text-embedding-004
AI_ENABLED=false


# ---------------------------------------------------------------------
# Client applications
# ---------------------------------------------------------------------
# Android emulator reaches the host machine at 10.0.2.2.
# iOS simulator uses localhost. A physical device needs your LAN IP.
CUSTOMER_API_BASE_URL=http://10.0.2.2:8080/api/v1
RIDER_API_BASE_URL=http://10.0.2.2:8080/api/v1
ADMIN_API_BASE_URL=http://localhost:8080/api/v1
