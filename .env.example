# =====================================================================
# BD QuickMart - Root environment template
# =====================================================================
# Copy this file to `.env` in the repository root and adjust the values
# for your machine.  NEVER commit the `.env` file.
#
# The backend reads configuration from environment variables. Spring Boot and
# Maven do NOT read .env on their own; on Windows start with
# .\start-backend.ps1 (loads .env into the process), or export variables in
# your shell / IDE run configuration before starting the app.
#
# Database: Supabase PostgreSQL. The schema is owned by versioned Flyway
# migrations applied as a SEPARATE step with dedicated DDL-capable credentials
# (DB_MIGRATION_*). The running app connects with a least-privilege DML-only
# role (DB_*) and never runs DDL. NO credential is committed here.
#
# The two Flutter applications and the admin web app each have their own
# .env.example next to their source, because Vite/Flutter bundle
# configuration differently from the Spring backend.
# =====================================================================


# ---------------------------------------------------------------------
# OPTION A (recommended): single Supabase connection URI
# ---------------------------------------------------------------------
# Paste the COMPLETE Session Pooler URI from Supabase > Project Settings >
# Database > Connection string > URI (Session Pooler, port 5432). Example:
#   postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<POOLER_HOST>:5432/postgres
# The backend parses this at startup (host, port, db, user and a URL-encoded
# password) and ENFORCES sslmode=require. You do NOT need to split the URI
# into DB_URL/DB_USERNAME/DB_PASSWORD. Keep it SECRET and NEVER commit it.
#
# When SUPABASE_DATABASE_URL is set it is AUTHORITATIVE: it overrides any
# DB_URL/DB_USERNAME/DB_PASSWORD/DB_DIALECT below (so leftover local values
# cannot point the app at the wrong database). DATABASE_URL is accepted as a
# generic alias when it is a PostgreSQL URI. Leave both blank to use the
# split DB_* variables below (e.g. Render secret env vars).
SUPABASE_DATABASE_URL=
# DATABASE_URL=

# ---------------------------------------------------------------------
# OPTION B (split): runtime database connection (least-privilege role, DML only)
# ---------------------------------------------------------------------
# Use ONLY when SUPABASE_DATABASE_URL is blank. Use the Supabase Session
# Pooler (or direct) host with sslmode=require. Placeholders only - no real
# values.
DB_URL=jdbc:postgresql://<POOLER_HOST>:5432/postgres?sslmode=require
DB_USERNAME=<DB_APP_ROLE>
DB_PASSWORD=<DB_APP_PASSWORD>
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Flyway owns the schema; Hibernate must never create or alter tables.
# Use "validate" in CI/staging to assert entity/schema alignment.
DB_DDL_AUTO=none

# Keep the pool small to respect Supabase connection limits.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=5000
# -1 lets the backend boot even while PostgreSQL is temporarily unavailable;
# /actuator/health/readiness reports the real connectivity state.
DB_POOL_INIT_FAIL_TIMEOUT=-1
DB_SHOW_SQL=false


# ---------------------------------------------------------------------
# Flyway migration step (DDL-capable role) - NOT used by the running app
# ---------------------------------------------------------------------
# Only needed for `mvn flyway:migrate` (or the optional in-app migration
# path). Use the DIRECT connection, not the pooler. These must identify a
# role with schema DDL privileges; keep them out of the runtime process.
# Never commit real credentials.
DB_MIGRATION_URL=
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
# Leave false in production: migrations are a separate step. If set true,
# ALL THREE DB_MIGRATION_* variables above MUST be provided.
SPRING_FLYWAY_ENABLED=false


# ---------------------------------------------------------------------
# Server / deployment
# ---------------------------------------------------------------------
# Render injects PORT and the app binds via ${PORT:${SERVER_PORT:8080}}.
# Do NOT define PORT as an empty value locally - leave it unset.
SERVER_PORT=8080
# Public base URL advertised in the OpenAPI server list (no secret).
APP_PUBLIC_URL=http://localhost:8080
LOG_LEVEL_BACKEND=INFO
LOG_LEVEL_SQL=INFO


# ---------------------------------------------------------------------
# API
# ---------------------------------------------------------------------
APP_API_VERSION=v1
APP_API_BASE_PATH=/api

# Comma-separated origins allowed to call the API from a browser. Add the
# deployed admin-web (Vercel) origin in production.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ---------------------------------------------------------------------
# Authentication / JWT (Goal 02)
# ---------------------------------------------------------------------
# HS256 signing secret: Base64-encoded OR a raw passphrase, at least 32
# bytes. Generate locally, e.g.:  openssl rand -base64 48
# NEVER commit a real secret. Leaving this blank makes the backend refuse
# to start (outside test/dev) rather than silently using a weak key.
JWT_SECRET=
JWT_ISSUER=bd-quickmart-backend
# Token lifetimes in seconds (access 15 min, refresh 7 days).
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
# Emergency local-dev escape hatch only. The generated key is ephemeral and
# invalidates every token on restart. Never enable in production.
JWT_ALLOW_EPHEMERAL_DEV_KEY=false


# ---------------------------------------------------------------------
# First-administrator bootstrap (Goal 02) - DISABLED by default
# ---------------------------------------------------------------------
# Opt-in creation of the first SUPER_ADMIN. All four fields are required
# when enabled. Disable again immediately after the first successful start:
# env vars are visible through `ps`. Never commit a real password here.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_FULL_NAME=
APP_BOOTSTRAP_ADMIN_PHONE=


# ---------------------------------------------------------------------
# AI providers (Gemini / Groq)
# ---------------------------------------------------------------------
# Supply real keys locally; leave blank to run with AI features disabled.
# Never commit real keys to the repository.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_CHAT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=text-embedding-004
AI_ENABLED=false


# ---------------------------------------------------------------------
# Client applications
# ---------------------------------------------------------------------
# Android emulator reaches the host machine at 10.0.2.2.
# iOS simulator uses localhost. A physical device needs your LAN IP.
CUSTOMER_API_BASE_URL=http://10.0.2.2:8080/api/v1
RIDER_API_BASE_URL=http://10.0.2.2:8080/api/v1
ADMIN_API_BASE_URL=http://localhost:8080/api/v1
